# PUBLIC development project ID only. Never put a CDP API key or Wallet Secret here.
VITE_CDP_PROJECT_ID=
# Operator assertion, not a provider attestation. Keep false until you have
# independently confirmed this is a separate, empty DEVELOPMENT project.
VITE_DEVELOPMENT_PROJECT_CONFIRMED=false
# Open the frontend at exactly http://localhost:4376 and allowlist that one
# development origin in Coinbase and the local backend. Vite binds 127.0.0.1.
# PUBLIC exact separate trusted LOCAL enrollment endpoint (not a CDP URL).
# Leave blank to keep enrollment blocked. Only http://127.0.0.1:port is accepted.
# Example when the separately configured backend is running: http://127.0.0.1:4377
# localhost is a frontend domain here, NOT an interchangeable backend alias.
VITE_ENROLLMENT_ORIGIN=
